# Example configuration for DNS Intelligence services

# NATS connection
NATS_URL=nats://localhost:4222

# Raw DNS JetStream stream
RAW_STREAM_NAME=DNS_RAW
RAW_SUBJECT=dns.raw.v1

# Normalizer (JetStream consumer)
NORMALIZER_DURABLE=dns-normalizer
NORMALIZER_BATCH_SIZE=100
FEED_SUBJECT=dns.feed.v1

# Aggregator worker (uses its own .env under aggregator-worker/ if needed)
STREAM_NAME=DNS_FEED
SUBJECT=dns.feed.v1

# Example gateway identity
GATEWAY_DEVICE_ID=gateway-raw-1
